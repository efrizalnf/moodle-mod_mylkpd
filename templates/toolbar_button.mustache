{{!
    @template mod_mylkpd/toolbar_button

    One toolbar button.

    Context variables required for this template:
    * attr - data attribute name (data-mylkpd-<attr>)
    * value - attribute value
    * icon - icon HTML (built by the plugin)
    * label - accessible label and tooltip
    * showlabel - whether the label is shown next to the icon
    * active - whether the button is pressed
    * istool - whether it is a tool (has aria-pressed)

    Example context (json):
    {"attr": "tool", "value": "pen", "icon": "&#9998;", "label": "Pencil", "showlabel": true, "active": false, "istool": true}
}}
<button type="button" class="btn btn-sm {{#active}}btn-primary{{/active}}{{^active}}btn-outline-secondary{{/active}}" data-mylkpd-{{attr}}="{{value}}" title="{{label}}" aria-label="{{label}}"{{#istool}} aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}"{{/istool}}><span class="mylkpd-icon" aria-hidden="true">{{{icon}}}</span>{{#showlabel}}<span class="mylkpd-tool-label">{{label}}</span>{{/showlabel}}</button>
