{{!
    @template mod_mylkpd/submission_filters

    Filter of the submissions page: all, not submitted, submitted, not graded, graded, with how many each.

    Context variables required for this template:
    * label - accessible name of the filter
    * items - list of {label, title, count, url, active}

    Example context (json):
    {"label": "Show", "items": [
        {"label": "All", "title": "Everyone", "count": 30, "url": "#", "active": true},
        {"label": "Not graded", "title": "Submitted, no grade yet", "count": 5, "url": "#", "active": false}
    ]}
}}
<nav class="mylkpd-filters mb-3" aria-label="{{label}}">
    <span class="mylkpd-filters-label small text-muted">{{label}}:</span>
    <ul class="nav nav-pills">
        {{#items}}
        <li class="nav-item">
            <a class="nav-link{{#active}} active{{/active}}" href="{{url}}" title="{{title}}"{{#active}} aria-current="page"{{/active}}>
                {{label}} <span class="badge {{#active}}bg-light text-dark{{/active}}{{^active}}bg-secondary{{/active}}">{{count}}</span>
            </a>
        </li>
        {{/items}}
    </ul>
</nav>
