{{!
    @template mod_mylkpd/toolbar

    The editing toolbar: rows of grouped tools, a message line and, for group work, who is online.

    Context variables required for this template:
    * label - toolbar label
    * rows - list of {groups, help}; a group has label, extra (class), buttons, swatches or widths
    * presence - whether to show who is online
    * namestoggle - label of the "show names" switch (group work), or empty

    Example context (json):
    {"label": "Toolbar", "rows": [{"groups": [{"label": "Tools", "extra": "mylkpd-tools",
      "buttons": [{"attr": "tool", "value": "text", "icon": "T", "label": "Text", "showlabel": true, "active": true, "istool": true}]},
      {"label": "Colour", "extra": "mylkpd-style", "swatches": [{"color": "#1a47b8", "label": "Blue", "active": true}],
       "widths": {"label": "Thickness", "options": [{"value": 4, "label": "Medium", "selected": true}]}}],
      "help": {"title": "Help", "text": "Click on the page."}}], "presence": true, "namestoggle": "Show names"}
}}
<div class="mylkpd-toolbar" role="toolbar" aria-label="{{label}}">
    {{#rows}}
    <div class="mylkpd-row">
        {{#groups}}
        <div class="mylkpd-group {{extra}}" role="group" aria-label="{{label}}">
            {{#buttons}}{{> mod_mylkpd/toolbar_button}}{{/buttons}}
            {{#swatches}}<button type="button" class="mylkpd-swatch{{#active}} active{{/active}}" style="background-color: {{color}}" data-mylkpd-color="{{color}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}" aria-label="{{label}}" title="{{label}}"></button>{{/swatches}}
            {{#widths}}
            <select class="custom-select form-select form-select-sm mylkpd-width" name="mylkpdwidth" data-mylkpd-width="1" aria-label="{{label}}" title="{{label}}">
                {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
            </select>
            {{/widths}}
        </div>
        {{/groups}}
        {{#help}}
        <details class="mylkpd-help">
            <summary class="btn btn-sm btn-link">&#9432; {{title}}</summary>
            <div class="mylkpd-help-text small">{{text}}</div>
        </details>
        {{/help}}
    </div>
    {{/rows}}
    <div class="mylkpd-hint small" data-mylkpd-hint="1" role="status" aria-live="polite"></div>
    {{#namestoggle}}
    <div class="mylkpd-row mylkpd-teamrow">
        {{#presence}}<div class="mylkpd-presence" id="mylkpd-presence" aria-live="polite"></div>{{/presence}}
        {{> mod_mylkpd/names_toggle}}
    </div>
    {{/namestoggle}}
</div>
