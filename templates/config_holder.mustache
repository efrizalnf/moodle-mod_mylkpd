{{!
    @template mod_mylkpd/config_holder

    Hidden element that holds the settings (JSON) a JavaScript module of this plugin reads on start.

    Context variables required for this template:
    * id - element id passed to the module's init()
    * config - settings as JSON

    Example context (json):
    {"id": "mylkpd-ai-config", "config": "{}"}
}}
<div id="{{id}}" class="mylkpd-config" hidden data-mylkpd-config="{{config}}"></div>
