{{!
    @template mod_mylkpd/ai_status

    Plugin settings: whether the AI API is connected, with a "Check connection" button.

    Context variables required for this template:
    * state - ok, fail or none
    * title - status text
    * details - model, response time and when it was checked
    * message - error message, or empty
    * checklabel - button label
    * testurl, testlabel - link to the detailed test page
    * hint - explanation under the button
    * config - settings for mod_mylkpd/aistatus (JSON)

    Example context (json):
    {"state": "ok", "title": "Connected", "details": "openai / model · 1.2 s", "message": "", "checklabel": "Check connection",
     "testurl": "/mod/mylkpd/aitest.php", "testlabel": "Details", "hint": "Uses the values in this form.", "config": "{}"}
}}
<div class="mylkpd-aistatus mylkpd-aistatus-{{state}}" id="mylkpd-aistatus" data-mylkpd-aistatus="box" data-mylkpd-config="{{config}}">
    <div class="mylkpd-aistatus-line" role="status" aria-live="polite">
        <span class="mylkpd-aistatus-dot" aria-hidden="true"></span>
        <strong data-mylkpd-aistatus="title">{{title}}</strong>
        <span class="mylkpd-aistatus-details small text-muted" data-mylkpd-aistatus="details">{{details}}</span>
    </div>
    <div class="mylkpd-aistatus-message small" data-mylkpd-aistatus="message">{{message}}</div>
    <div class="mylkpd-aistatus-actions">
        <button type="button" class="btn btn-secondary" data-mylkpd-aistatus="check">&#128268; {{checklabel}}</button>
        <a href="{{testurl}}">{{testlabel}}</a>
    </div>
    <div class="small text-muted">{{hint}}</div>
</div>
