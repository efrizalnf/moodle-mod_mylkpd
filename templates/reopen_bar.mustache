{{!
    @template mod_mylkpd/reopen_bar

    Bottom bar of a submitted worksheet: "Edit again", or why it cannot be edited any more.

    Context variables required for this template:
    * action - form URL
    * sesskey
    * confirm - confirmation question
    * canreopen - whether the student may edit again
    * message - hint or reason
    * label - button label

    Example context (json):
    {"action": "/mod/mylkpd/view.php?id=1", "sesskey": "abc", "confirm": "Edit again?", "canreopen": true,
     "message": "You can still change your answers.", "label": "Edit again"}
}}
<form method="post" action="{{action}}" class="mylkpd-actions mylkpd-reopen" data-mylkpd-confirm="{{confirm}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="reopen" value="1">
    <span class="mylkpd-savestate small text-muted">{{message}}</span>
    {{#canreopen}}<button type="submit" class="btn btn-primary">&#9998; {{label}}</button>{{/canreopen}}
    {{^canreopen}}<button type="button" class="btn btn-outline-secondary" disabled="disabled">&#128274; {{label}}</button>{{/canreopen}}
</form>
