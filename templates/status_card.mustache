{{!
    @template mod_mylkpd/status_card

    The student's status card: status, schedule, group progress, grade, feedback and rubric.

    Context variables required for this template:
    * badges - list of {text, class}
    * info - status explanation
    * schedule - list of {label, value, strong, hint, hintclass}
    * latewarning - warning before submitting late, or empty
    * groupinfo - group and members, or empty
    * teamprogress - {label, members: [{name, done}]} or false
    * grade - grade text, or empty
    * gradelabel, feedbacklabel - labels
    * feedback - teacher feedback, or empty
    * rubric - filled-in rubric HTML (rendered by Moodle's grading form), or empty

    Example context (json):
    {"badges": [{"text": "Submitted", "class": "bg-success"}], "info": "Submitted on 9 November.",
     "schedule": [{"label": "Due", "value": "9 November 2026, 23:59", "strong": true, "hint": "", "hintclass": ""}],
     "latewarning": "", "groupinfo": "", "teamprogress": false, "grade": "80 / 100", "gradelabel": "Your grade",
     "feedbacklabel": "Feedback", "feedback": "Good work", "rubric": ""}
}}
<div class="mylkpd-statuscard">
    <div class="mylkpd-status-line">
        {{#badges}}<span class="badge {{class}}">{{text}}</span> {{/badges}}<span class="mylkpd-status-text">{{info}}</span>
    </div>
    {{#schedule.0}}
    <div class="mylkpd-schedule small">
        {{#schedule}}
        <span class="mylkpd-schedule-item"><span class="text-muted">{{label}}: </span>{{#strong}}<strong>{{value}}</strong>{{/strong}}{{^strong}}{{value}}{{/strong}}{{#hint}} <span class="{{hintclass}}">{{hint}}</span>{{/hint}}</span>
        {{/schedule}}
    </div>
    {{/schedule.0}}
    {{#latewarning}}<div class="mylkpd-latewarning">{{latewarning}}</div>{{/latewarning}}
    {{#groupinfo}}<div class="mylkpd-groupinfo small text-muted">{{groupinfo}}</div>{{/groupinfo}}
    {{#teamprogress}}
    <div class="mylkpd-teamprogress">
        <span class="small">{{label}}</span>
        {{#members}}<span class="mylkpd-teamchip {{#done}}mylkpd-teamchip-done{{/done}}{{^done}}mylkpd-teamchip-wait{{/done}}">{{#done}}&#10003;{{/done}}{{^done}}&#9675;{{/done}} {{name}}</span>{{/members}}
    </div>
    {{/teamprogress}}
    {{#grade}}<div class="mylkpd-grade"><strong>{{gradelabel}}: </strong>{{grade}}</div>{{/grade}}
    {{#feedback}}<div class="mylkpd-feedback"><strong>{{feedbacklabel}}: </strong><span class="mylkpd-feedback-text">{{feedback}}</span></div>{{/feedback}}
    {{#rubric}}<div class="mylkpd-rubricresult">{{{rubric}}}</div>{{/rubric}}
</div>
